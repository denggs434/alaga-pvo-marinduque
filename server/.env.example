# Copy this file to .env and fill in your own values.
PORT=5000

# Local MongoDB or a MongoDB Atlas connection string
# (on Vercel the MongoDB Atlas integration sets MONGODB_URI instead; either name works)
MONGO_URI=mongodb://127.0.0.1:27017/alaga

# Any long random string (16+ characters). Used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# PVO admin account created by `npm run seed`
ADMIN_EMAIL=admin@alaga.ph
ADMIN_PASSWORD=Admin123!

# Only set this if the client is hosted on a different origin than the API
# CLIENT_ORIGIN=https://your-frontend.example.com

# Optional: Google Gemini key (free at https://aistudio.google.com) makes Alagai answer with AI.
# Without it Alagai uses its built-in pet-care answers.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Copy this file to .env and fill in your own values.
PORT=5000

# Local MongoDB or a MongoDB Atlas connection string
# (on Vercel the MongoDB Atlas integration sets MONGODB_URI instead; either name works)
MONGO_URI=mongodb://127.0.0.1:27017/alaga

# Any long random string (16+ characters). Used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# PVO admin account created by `npm run seed`
ADMIN_EMAIL=admin@alaga.ph
ADMIN_PASSWORD=Admin123!

# Only set this if the client is hosted on a different origin than the API
# CLIENT_ORIGIN=https://your-frontend.example.com

# Alagai, the AI pet-care assistant (optional; without a model it gives labelled basic answers)
# On Vercel it uses AI Gateway through the project's OIDC token: nothing to set.
# Locally: AI_GATEWAY_API_KEY=..., or run `vercel env pull` for VERCEL_OIDC_TOKEN.
# ALAGAI_MODEL=anthropic/claude-haiku-5.5
# Any other OpenAI-compatible provider instead of AI Gateway:
# ALAGAI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# ALAGAI_API_KEY=your-key
# ALAGAI_MODEL=gemini-2.5-flash

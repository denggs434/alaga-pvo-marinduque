# Copy this file to .env and fill in your own values.
PORT=5000

# Local MongoDB or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/voltyard

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@voltyard.ph
ADMIN_PASSWORD=Admin123!

# Allowed origin when the client is served from a different host (optional)
CLIENT_ORIGIN=http://localhost:5000
